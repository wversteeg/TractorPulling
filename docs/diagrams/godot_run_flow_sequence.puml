@startuml godot_run_flow_sequence
title The game's flow: a season's event against the rivals, then the top tens
autonumber
actor Player
participant "pull.gd" as Pull
participant "StartScreen / BoardScreen /\nResultScreen" as Screens
participant "TractorPullEvent" as Event
participant "TractorPullRun" as Run

Pull -> Event : start_season(season, seed: new each launch)
Pull -> Event : start_event()
Pull -> Screens : start screen: get_event() (name, n of count), layout
loop each frame on the start screen and the board
  Pull -> Event : advance(slices of steps, ~6 ms a frame)\nwhile the turn is the rivals'
end
opt Practice
  Player -> Screens : Practice
  Pull -> Run : setup_practice(event, controls)
  note right of Pull : a free pull; again and menu work
end
Player -> Screens : Event
loop until get_event().turn is "finished"
  Pull -> Screens : the board: get_log() rows,\nwhat is up next
  alt turn "player_pull"
    Player -> Screens : Pull
    Pull -> Run : setup_event_pull(event, controls)\n(the sled as the operator has set it)
    loop every frame while pulling
      Pull -> Run : set_controls(...), advance(frame time)
    end
    Pull -> Event : record_pull(run)
    Event --> Pull : the log entry: the operator's verdict
    Pull -> Screens : result screen; Continue
  else turn "player_decision"
    Player -> Screens : Keep or Pull again
    Pull -> Event : decide(keep)
  end
end
Player -> Screens : Results
Pull -> Screens : the event's top ten: get_standings()
Player -> Screens : Season
Pull -> Event : score_event()
Pull -> Screens : the season's top ten: get_season_standings()
alt more events
  Player -> Screens : Next event
  Pull -> Event : start_event()
else the season is over
  Player -> Screens : New season
  Pull -> Event : start_season(season, new seed)
end
@enduml
