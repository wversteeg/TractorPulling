@startuml driver_input_sequence
title A scripted rival's input, each step (driver::input)
autonumber
participant "Caller\n(field::run_pull, LiveEvent)" as Caller
participant "driver::input" as Driver
participant "driveline::shifts_under_load" as Load

Caller -> Driver : input(plan, driver state, t_s, tractor state, tractor params)
Driver -> Driver : before select_gear_s: neutral, clutch pressed, idle
Driver -> Driver : then plan.gear at plan.throttle; from launch_s the clutch\ncomes up over clutch_slip_in_s
opt plan.launch_hold_share > 0 (a held launch)
  alt plan.launch_feather_share > 0 and held_s < launch_hold_max_s (feathered)
    Driver -> Driver : rate = clamp((engine - hold) / (feather_share x rated), -1, 1)
    Driver -> Driver : wheels past plan.spin_ease_slip: rate = min(rate, -kSpinClutchRate x how far past)
    Driver -> Driver : clutch up (or back) at rate x the plan's rate; held_s += step
  else engine < launch_hold_share x rated speed and held_s < launch_hold_max_s
    Driver -> Driver : ease the clutch back at the same rate; held_s += step
  else
    Driver -> Driver : let it come up at the plan's rate
  end
end
opt plan.spin_ease_slip > 0, rear slip ratio > spin_ease_slip, not feathering the launch
  Driver -> Driver : fuel trimmed towards plan.spin_fuel as the slip grows\n(engine::throttle_for_fuel at the engine's speed: never shut off)
end
opt clutch fully in and plan.downshift_share > 0
  Driver -> Driver : below = engine < downshift_share x rated speed
  Driver -> Driver : watching |= !below\n(the engine is back from the launch's dip)
  alt a load shift already this pull
    Driver -> Driver : gear = the gear in (under way none lower)
  else watching, below, the engine running
    Driver -> Load : shifts_under_load(driveline state, params, gear in - 1)
    Load --> Driver : true if the gearbox can
    Driver -> Driver : gear = gear in - 1
  end
end
Driver --> Caller : vehicle::Input
Caller -> Caller : run::step(..., input)
@enduml
