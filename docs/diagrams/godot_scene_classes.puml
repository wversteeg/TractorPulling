@startuml godot_scene_classes
title The pull scene (app/godot/scenes/pull.tscn): a season's events against the rivals, at a club venue
hide empty members
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0

package "Godot 4.7" {
  class Node3D
  class SceneTree
  class Control
  class AudioStreamPlayer
}

package "GDScript (app/godot/scripts)" {
  class "pull.gd" as Pull {
    +career_path : String
    +season_seed : int
    +autoplay : bool
    +whole_turn : bool = true
    +settings_path : String
    +save_path : String
    +pro, tilt : bool
    +practice : bool
    +run : TractorPullRun
    +event : TractorPullEvent
    +flagman, end_flagman : Flagman
    +parked : Array[TractorView]
    +hitch_marker : MeshInstance3D
    +driver : Callable, a scripted driver for tests
    +screen : Screen {START, SETTINGS, GARAGE, EVENT,\n  SETUP, PULLING, RESULT, EVENT_END, SEASON}
    +show_start(error)
    -_new_season(new_career)
    -_move_up()
    -_resume_season() : bool
    -_save_season()
    -_change_settings(pro, tilt)
    -_show_setup(for_practice)
    -_start_practice()
    -_start_event_pull()
    -_place_parking()
    -_build(error) : bool
    +class_look(dimensions) : TractorLook
    -_build_turn(dimensions)
    -_camera_target(delta) : Vector3
    -_show_officials(snapshot, delta)
    +{static} signal_for(snapshot, turn) : String
    -_set_screen(screen)
    -_process(delta)
    -_advance_rivals()
    -_show_result()
    -_show_event(), _show_event_end(), _show_season()
    -_read_controls()
    -_show(delta)
  }
  class TrackView {
    +build(dimensions)
  }
  class TractorView {
    +look : TractorLook
    +pulling_look() : bool : a roll bar draws a pulling tractor
    +body_scale() : float : bigger with a longer wheelbase
    +front_weights_position() : Vector3
    +build(dimensions) : built again for another look or sizes
    +show_snapshot(snapshot, delta)
    +show_cockpit(snapshot) : wheel and gauges
    +hitch_position() : Vector3
    +cab_camera() : Camera3D
  }
  class TractorLook {
    +name : String : the class
    +paint, paint_dark, trim, rim, disc, ring : Color
    +number : String
    +driver_shirt : Color
    +{static} schemes() : Dictionary : by class name
    +{static} for_class(class_name, protection) : TractorLook
    +rival(i) : TractorLook : the class's trim, own paint
  }
  class SledView {
    +build(dimensions)
    +transport : float
    +show_snapshot(snapshot, delta)
    +start_run(snapshot)
    +show_box_mass(box_mass_kg)
    +weights_shown() : int
    +flap_angle() : float : the folding fenders, 45° and swinging
    +hook_position() : Vector3
    +camera_mount() : Vector3
    +{static} transport_wanted(snapshot) : float
    +{static} weight_count(box_mass_kg) : int
    +{static} rear_of(dimensions) : float : 12.5 m from the hook
    +{static} pan_back_of(dimensions) : float : the sled's middle
  }
  class VenueView {
    +RETURN_LANE_M, PARKING_RIGHT_OF_LANE_M
    +PLAYER_BAY_X_M, RIVAL_BAYS_X_M
    +build(dimensions)
    +show_distance(sled_m)
    +excitement() : float
    +banner_at_m() : float
    +set_look(event) : size, time, track soil
    +look() : Dictionary
    +celebrate() : a big event's full-pull show
    +show_running() : bool
    +{static} environment() : WorldEnvironment
    +{static} light(world, sun, time)
    +{static} track_colours(clay_fraction, moisture) : Array[Color]
    +{static} past_lane_m(side) : float
    +show_signal(signal) : the gantry's light
    +signal_shown() : String
    +floodlight_masts() : Array[Vector2], at sunset and in the evening
    +rival_lights() : Array[Vector2], a post behind each rival's bay
    +track_end() : TrackEnd
    +show_screen_live(target, delta)
    +show_screen_standings(rows)
  }
  class TrackEnd {
    the pile of dirt past the run-off, the trailers and
    pop-up tents behind it, a big screen at a club or big event
    +build(length_m, lane_m, strip_m, shades, trailers, screen, tents)
    +tent_count() : int
    +pile_at_m() : Vector2
    +trailer_count() : int
    +has_screen() : bool
    +show_live(target, delta) : a TV camera, 12 Hz
    +show_standings(rows)
    +screen_mode() : String
    +screen_lines() : PackedStringArray
    --
    -_screen_view : SubViewport (384 x 216)
    -_tv : Camera3D
  }
  class Flagman {
    +stand(at, facing)
    +show_signal(green, raise, wave, delta)
    +colour_name() : String
    +raised() : bool
  }
  class TrackMarks {
    +build(dimensions)
    +show_snapshot(snapshot)
    +point_counts() : Vector3i
  }
  class People <<static>> {
    +{static} standing() : ArrayMesh
    +{static} seated() : ArrayMesh
    +{static} material(shirt, skin) : ShaderMaterial
    +{static} one(seated, shirt) : MeshInstance3D
  }
  class Art <<static>> {
    +{static} material(colour, roughness, metallic) : StandardMaterial3D
    +{static} box(size, colour), cylinder(...), sphere(...)
    +{static} axle_cylinder(radius_m, width_m, colour)
    +{static} rounded_box(size, radius_m, along, segments) : ArrayMesh
    +{static} many(mesh, transforms, material, colours, custom) : MultiMeshInstance3D
    +{static} label(text, size_px, colour, outline) : Label3D
    +{static} ground_texture(dark, light, frequency, seed) : NoiseTexture2D
    +{static} ground_normal(frequency, seed, strength) : NoiseTexture2D
    +{static} paint(colour, roughness) : StandardMaterial3D
    +{static} puff_mesh(size_m) : QuadMesh
    +{static} torus_across(radius_m, thickness_m) : Mesh
    +{static} tire(spin, radius_m, width_m, colour)
    +{static} rim(spin, radius_m, width_m, outward, bolts, colour)
    +{static} append_coloured(tool, mesh, at, colour)
  }
  class KenneyModels <<static>> {
    +{static} scene(path) : Node3D
  }
  class Trees <<static>> {
    +{static} pine() : ArrayMesh
    +{static} broadleaf() : ArrayMesh
    +{static} many(mesh, places, random, smallest, largest) : MultiMeshInstance3D
  }
  class ChainView {
    +show_between(hitch, hook, tension_n)
  }
  class DriveControls {
    +gear : int
    +lowest_gear : int
    +gear_count : int
    +has_reverse : bool
    +pro, tilt : bool
    +tilt_steering : TiltSteering
    +throttle() : float
    +clutch() : float
    +brake_left(), brake_right() : float
    +latch_brakes(latched)
    +steering() : float
    +set_layout(pro)
    +set_steering(by_tilt)
    +set_clutch_range(full_grip_pedal, bite_pedal)
    +set_gear(gear)
    +show_gear(gear_in)
    +reset()
    +reset_fingers()
    ..signals..
    camera_requested, restart_requested,
    menu_requested
  }
  class Haptics {
    +enabled : Dictionary (Kind: bool)
    +vibrate : Callable(ms, strength)
    +configure(dimensions)
    +update(snapshot, asked_gear, delta)
    +show_result(result)
    +set_enabled_by_key(by_key), enabled_by_key() : Dictionary
    --
    Kind: clutch bite, wheelspin, lugging, gear,
    chain, landing, full pull, chalk line
  }
  class HapticsScreen {
    +kind_buttons : Dictionary
    +all_on_button, all_off_button, back_button : TouchButton
    +show_haptics(by_key)
    ..signals..
    changed(by_key), done
  }
  class EngineSound {
    +enabled : bool
    +loops : bool (the web: loops made ahead)
    +idle_loop, load_loop : AudioStreamPlayer
    +make_loop(state) : AudioStreamWAV
    +cylinders : int
    +configure(dimensions)
    +show_snapshot(snapshot)
    +sample_frames(count) : PackedVector2Array
    +loudness(running, omega_rad_s, throttle) : float
    +{static} firing_hz(omega_rad_s, cylinders) : float
  }
  class Hud {
    +build(dimensions)
    +set_parking(bay)
    +show_snapshot(snapshot, title, pro)
    +turn_text(snapshot) : String
    +slack_to_go_m(snapshot) : float, still to creep into the ready band
    +guide_shown() : bool, the slack gauge
    +boost_bar() : float, the boost gauge's reading
    +show_signal(signal) : the lamp on the HUD
    +signal_shown() : String
    +{static} gear_name(gear) : String
  }
  class MenuPanel {
    +panel_size : Vector2
    +eyebrow_label : Label
    +add_line(font_size, colour) : Label
    +add_title(title, font_size, eyebrow) : Label
    +add_heading(text) : Label
    +add_item(control)
    +add_button_row() : HBoxContainer
    +add_button(row, text, icon) : TouchButton
    +release_buttons()
  }
  class StartScreen {
    +practice_button, garage_button, event_button : TouchButton
    +continue_button, new_season_button, new_career_button : TouchButton
    +move_up_button : TouchButton
    +settings_button : GearButton
    +show_event(event, error, career)
    +show_choice(season)
    ..signals..
    practice_requested, event_requested, garage_requested,
    settings_requested, continue_requested,
    new_season_requested, new_career_requested, move_up_requested
  }
  class SettingsScreen {
    +easy_button, pro_button : TouchButton
    +slider_button, tilt_button : TouchButton
    +new_career_button, start_button, done_button : TouchButton
    +sound_on_button, sound_off_button, haptics_button : TouchButton
    +money_button : TouchButton, for testing
    +build_label : Label, the build at the bottom
    +show_settings(pro, tilt, tilt_available, guidance, rungs, sound)
    +show_money(money_eur)
    +start_rung() : int
    +release_buttons()
    ..signals..
    changed(pro, tilt, guidance), sound_changed(on), haptics_requested,
    done, new_career_requested(rung),
    money_requested(amount_eur)
  }
  class MenuBackdrop {
    a tractor pulling the sled at sunset,
    drawn to scale in 2D behind the menus;
    tools/make_icons.gd draws the icons from it
    +view_m : Rect2
    +layers : BACK, FRONT
    +animated : bool
    +time_s : float
  }
  class GarageScreen {
    the workshop, a part's screen, a choice's screen
    +event : TractorPullEvent, for the dyno charts
    +view : WORKSHOP, UPGRADE, CHOICE
    +upgrade_pins, choice_pins : Array[PartPin]
    +buy_button, back_button, done_button : TouchButton
    +alternative_buttons : Array[TouchButton]
    +show_garage(garage, message)
    +show_workshop()
    +open_upgrade(index)
    +open_choice(index)
    +{static} euros(amount) : String
    ..signals..
    buy_requested(index), choice_requested(choice, alternative), done
  }
  class TractorSketch {
    a pulling tractor from the side, to scale
    +ballast_share, ballast_kg : float
    +hitch_low_m, hitch_top_m, hitch_m : float
    +footprint : float
    +anchor(part) : Vector2
    +to_px(m) : Vector2
  }
  class PartPin {
    a part's pin: progress ring, icon, € badge
    +part, title, note : String
    +share : float
    +choice, complete, affordable : bool
    +ring_centre() : Vector2
  }
  class LevelLine {
    a part's levels on one line (tires as treads)
    +show_levels(labels, costs, level, treads, counts)
  }
  class DynoChart {
    power against engine speed
    +show_curves(curves)
  }
  class GarageArt {
    the parts' and the menus' icons, drawn
    +{static} draw_icon(canvas, part, centre, size, colour)
    +{static} draw_tread(canvas, rect, depth, colour)
  }
  class BuildInfo {
    which build this is, from res://build_info.cfg
    (scripts/godot_export.sh writes it from git)
    +{static} describe(path) : String
  }
  class GameSettings {
    +pro, tilt, guidance, sound : bool
    +haptics : Dictionary
    +{static} read(path) : GameSettings
    +write(path) : Error
  }
  class TiltSteering {
    +gravity : Callable
    +available() : bool
    +centre()
    +steering() : float
    +{static} shape(tilt_deg) : float
  }
  class GearButton
  class SetupScreen {
    the pit board: the track's card, the lane as the
    crew walked it, the start, the tractor set up
    +ballast_slider, pressure_slider, hitch_slider : TouchSlider
    +start_slider : TouchSlider, full left .. full right
    +pull_button, back_button : TouchButton
    +show_setup(title, tuning, pro, tilt, track, track_name, crew)
    +show_values(tuning)
    +start_y_m() : float
    +tip_text() : String : the crew chief: track, gear, hitch
    +release_sliders()
    +release_buttons()
    ..signals..
    tuning_changed(ballast_position, pressure_bar, hitch_m),
    start_changed(y_m),
    pull_requested, back_requested
  }
  class LaneMap {
    the lane from above: the crew's spots, blurred
    by how sure it is; the tires' tracks, the pan;
    the crew's own start marked
    +report : Dictionary (get_crew_report())
    +start_y_m : float
    +show_report(crew)
    +show_start(y_m)
  }
  class ResultScreen {
    +again_button, menu_button : TouchButton
    +continue_button : TouchButton
    +show_result(title, result, full_pull_m, entry)
    ..signals..
    again_requested, menu_requested,
    continue_requested
  }
  class BoardScreen {
    +first_button, second_button : TouchButton
    +set_title(text)
    +set_rows(rows, highlights, newest_last, strong)
    +row_count() : int
    +set_status(text)
    +status() : String
    +set_buttons(first, second)
    ..signals..
    first_tapped, second_tapped
  }
  class EventTexts <<static>> {
    +{static} pull_name(kind, pull_off_round) : String
    +{static} reach(entry) : String
    +{static} verdict(entry) : String
    +{static} log_row(entry) : PackedStringArray
    +{static} standing_row(line) : PackedStringArray
    +{static} leading_rows(log, places) : PackedInt32Array
    +{static} standing_rows(standings), season_rows(standings) : Array
    +{static} player_rows(standings) : PackedInt32Array
    +{static} season_row(line) : PackedStringArray
  }
  class TouchSlider {
    +vertical, springs_back, relative : bool
    +start_value, end_value, rest_value : float
    +colour : Color
    +label : String
    +filled : bool
    +value : float
    +has_band : bool
    +band_from, band_to, mark : float
    +set_band(from_value, to_value, mark_value)
    +clear_band()
    +position_of(value) : float
    +is_held() : bool
    +release()
  }
  class TouchButton {
    +text : String
    +fires_on_release : bool
    +selected : bool
    +rounded : bool
    +primary : bool
    +icon : String
    +readout : bool
    +disabled : bool
    +is_held() : bool
    +release()
    +draw_card() : Color
    ..signals..
    tapped
  }
  class CameraRig {
    +view : View {CHASE, CLOSE, CAB, SIDE, OVERHEAD}
    +next()
    +rumble : float
    +cab : Camera3D
    +current_camera() : Camera3D
    +follow(target, delta, smooth, heading_rad, sled_rear)
  }
  class TrackSpace <<static>> {
    +{static} point(x_m, y_m, z_m) : Vector3
  }
  class Graybox <<static>> {
    +{static} box(size, colour) : MeshInstance3D
    +{static} wheel(radius_m, width_m, colour) : MeshInstance3D
  }
}

package "tests (scripts/godot_test.sh)" {
  class "scene_test.gd" as SceneTest
  class "screenshots.gd" as Shots
  class "touch_test.gd" as TouchTest
  class "flow_test.gd" as FlowTest
  class "turn_test.gd" as TurnTest
}

class "TractorPullRun\n(see godot_classes)" as Run
class "TractorPullEvent\n(see godot_classes)" as Event

Node3D <|-- Pull
Node3D <|-- TrackView
Node3D <|-- TractorView
Node3D <|-- SledView
Node3D <|-- ChainView
Node3D <|-- VenueView
Node3D <|-- TrackMarks
Node3D <|-- CameraRig
Node3D <|-- Flagman
Pull *-- Run
Pull *-- Event
Pull *-- TrackView
Pull *-- VenueView : the grandstand, crowd, fences,\nboards, scoreboard, sky, hills
Pull *-- TrackMarks : ruts and the pan's band,\ncleared each pull
Pull *-- TractorView
Pull *-- "3" TractorView : the rivals in their bays\n(a whole turn)
Pull *-- "2" Flagman : at the start and down the track:\ngreen while the pull is good, red to stop
Pull *-- SledView
Pull *-- ChainView
Pull *-- CameraRig
Pull *-- DriveControls : the easy or pro layout's controls
DriveControls *-- "5" TouchSlider : steering (slider steering), hand throttle;\npro: clutch (its slipping range marked),\ntwo brakes
DriveControls *-- "6" TouchButton : gear +/- (R below N), N,\ncamera, again, menu
Pull *-- Hud
Pull *-- EngineSound : the engine heard on the track,\nmade from the snapshot
AudioStreamPlayer <|-- EngineSound
Pull *-- Haptics : the phone vibrates in the pull
Pull *-- HapticsScreen : from the settings
MenuPanel <|-- HapticsScreen
HapticsScreen ..> Haptics : its kinds
Pull *-- StartScreen
Pull *-- SettingsScreen : from the start screen's gear
Pull *-- GarageScreen : from the start screen
GarageScreen *-- TractorSketch : the workshop
GarageScreen *-- PartPin : a pin per part
GarageScreen *-- LevelLine
GarageScreen *-- DynoChart
TouchButton <|-- PartPin
GarageScreen ..> GarageArt
Pull ..> GameSettings : read at the start,\nwritten on a change
SettingsScreen ..> BuildInfo : shows
Pull ..> BuildInfo : prints at the start
StartScreen *-- GearButton
TouchButton <|-- GearButton
MenuPanel <|-- SettingsScreen
DriveControls *-- TiltSteering : steering by tilt,\ncentred at the pull's start
Pull *-- ResultScreen
Pull *-- SetupScreen : before every pull
SetupScreen *-- "4" TouchSlider : weights,\ntire pressure, hitch, start
SetupScreen *-- LaneMap : the lane
SetupScreen *-- TractorSketch : the setup shown
Pull *-- BoardScreen : the event, its results,\nthe season's standings
Pull ..> EventTexts
ResultScreen ..> EventTexts : the operator's verdict
MenuPanel <|-- StartScreen
MenuPanel <|-- ResultScreen
MenuPanel <|-- BoardScreen
Control <|-- MenuPanel
Pull *-- MenuBackdrop : behind the menus,\nthe 3D world not drawn
Control <|-- MenuBackdrop
Control <|-- Hud
MenuPanel ..> TouchButton
Control <|-- DriveControls
Control <|-- TouchSlider
Control <|-- TouchButton
TrackView ..> TrackSpace
TractorView ..> TrackSpace
SledView ..> TrackSpace
TrackView ..> Graybox
TractorView ..> Art
SledView ..> Art
ChainView ..> Art
VenueView ..> Art
VenueView *-- TrackEnd : past the\ntrack's end
TrackEnd ..> Art
VenueView ..> TrackSpace
VenueView ..> KenneyModels : CC0 models (assets/kenney):\ntents, barn, clouds
VenueView ..> Trees : copses and\nthe tree line
VenueView ..> People : the crowd, one\nMultiMesh a pose
TractorView ..> People : the driver
TractorView o-- TractorLook : its colours and number
Pull ..> TractorLook : the class's, and the rivals'
CameraRig ..> TractorView : the cab camera, at the driver's eyes
Flagman ..> People : the official
SledView ..> People : the operator
TrackMarks ..> TrackSpace
TrackMarks ..> SledView : where the pan's back edge is
SceneTree <|-- SceneTest
SceneTree <|-- Shots
SceneTest ..> Pull : autoplay, checks the views\nagainst the snapshot
Shots ..> Pull : autoplay, a PNG per camera
SceneTree <|-- TouchTest
TouchTest ..> DriveControls : simulated fingers\n(push_input) and a simulated\nmotion sensor (tilt)
SceneTree <|-- FlowTest
SceneTree <|-- TurnTest
TurnTest ..> Pull : headless, a scripted driver: the whole turn\nfrom the bay to the sled and back
FlowTest ..> Pull : a practice season (tests/data):\nstart, settings, practice, the event with its rivals,\nthe standings, next event; launched again:\ncontinue, new season
note bottom of Pull
  draws the blended snapshot and hands the run the controls;
  who pulls next and the standings are the event's (TractorPullEvent);
  no physics or rules: TrackSpace only turns track
  coordinates (x down the track, y left, z up) into Godot's
end note
@enduml
