@startuml godot_classes
title Godot binding (app/godot/extension): tp::session and the live season for GDScript
hide empty members
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0

package "Godot 4.7 (godot-cpp 10)" {
  class RefCounted
  class FileAccess <<engine>> {
    +{static} file_exists(path) : bool
    +{static} get_file_as_bytes(path) : PackedByteArray
  }
}

package "tp::godot_binding" {
  class TractorPullRun {
    -session_ : optional<session::Session>
    -setup_ : optional<session::Setup>
    -event_pull_ : optional<PullKey>
    -controls_ : session::Controls
    -dropped_ns_ : int64
    +setup(tractor_path, sled_path, track_path, controls_path) : String
    +setup_event_pull(event : TractorPullEvent, controls_path) : String
    +setup_practice(event : TractorPullEvent, controls_path) : String
    +set_controls(throttle, clutch_pedal, gear, steering, brake_left, brake_right)
    +advance(elapsed_ns) : int
    +get_dropped_ns() : int
    +get_snapshot() : Dictionary
    +get_dimensions() : Dictionary
    +get_layout() : String
    +is_finished() : bool
    +get_result() : Dictionary
    +get_state_hash() : String
    ..C++ only..
    +session() : const session::Session*
    +event_pull() : optional<PullKey>
  }
  class TractorPullEvent {
    -definition_ : optional<data::SeasonDefinition>
    -names_ : vector<string>
    -season_ : unique_ptr<field::LiveSeason>
    -tuning_ : vehicle::Tuning
    +start_season(season_path, seed) : String
    +get_save() : String
    +resume_season(season_path, save) : String
    +get_season() : Dictionary
    +start_event() : String
    +get_event() : Dictionary
    +advance(max_steps) : int
    +get_log(from) : Array
    +get_log_size() : int
    +get_standings() : Array
    +record_pull(run : TractorPullRun) : Dictionary
    +get_suggested_keep() : bool
    +decide(keep)
    +score_event() : bool
    +get_season_standings() : Array
    +get_tuning() : Dictionary
    +set_tuning(ballast_position, pressure_bar)
    ..C++ only..
    +player_setup() : optional<session::Setup>
    +practice_setup() : optional<session::Setup>
    +pull_key() : PullKey
  }
  class PullKey <<struct>> {
    +season_id : uint64
    +event : int
    +log_size : int64
  }
  TractorPullRun *-- PullKey : the pull a run\nwas set up for
  class "godot_files" as Files <<free functions>> {
    +read_godot_file(path) : optional<string>
  }
  class "register_types" as Register <<entry point>> {
    +tractor_pulling_init(...) : GDExtensionBool
  }
}

package "core and data_io (see their class diagrams)" {
  class "session::Session / Setup /\nControls / Snapshot / blend()" as Session
  class "data::load_tractor / load_sled /\nload_track / load_control_layout /\nload_season (path, ReadFile)" as Loaders
  class "data::run_setup(tractor, class_sled, track)\ndata::run_setup(tractor, LiveEvent)\ndata::venue(class_sled, track)" as RunSetup
  class "field::LiveSeason / LiveEvent" as Live
  class "vehicle::Tuning / tuned()\nchassis::rear_axle_share()" as Tuning
}

package "GDScript (app/godot)" {
  class "scenes/pull.tscn and its views\n(see godot_scene_classes), tests" as Scripts
}

RefCounted <|-- TractorPullRun
RefCounted <|-- TractorPullEvent
Register ..> TractorPullRun : registers
Register ..> TractorPullEvent : registers
TractorPullEvent *-- Live
TractorPullEvent *-- Tuning : the player's,\nfor the season
TractorPullEvent ..> Loaders : load_season
TractorPullEvent ..> RunSetup : venues, the player's Setup
TractorPullRun ..> TractorPullEvent : setup_event_pull,\nsetup_practice
TractorPullEvent ..> TractorPullRun : record_pull reads\nthe result
TractorPullRun *-- Session
TractorPullRun ..> Loaders : setup
TractorPullRun ..> RunSetup : the run's Setup
TractorPullRun ..> Files : the ReadFile
Files ..> FileAccess : res://, user://
Scripts ..> TractorPullRun : new(), setup, set_controls,\nadvance per frame, get_snapshot,\nget_dimensions at setup
Scripts ..> TractorPullEvent : a season at launch,\nthe rivals in slices per frame,\nthe boards
note bottom of TractorPullRun
  holds no game rules: everything goes through tp::session
  and field::LiveSeason (the player is puller 0, "You");
  values in and out are SI, on the track (docs/conventions.md)
end note
@enduml
