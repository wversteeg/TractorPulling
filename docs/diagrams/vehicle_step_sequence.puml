@startuml vehicle_step_sequence
title vehicle::step: one 1 kHz step of the whole tractor
autonumber
participant "Caller\n(pull::step, tool, test)" as Caller
participant "vehicle::step" as Step
participant "driveline" as Driveline
participant "chassis" as Chassis
participant "engine" as Engine
participant "tire" as Tire
participant "solve_chain" as Solve
participant "clutch::resolve" as Clutch

Caller -> Step : step(state, model, {throttle, clutch_pedal, gear},\n  Ground{rear, front surface}, Drawbar{pull, lift}, dt_s)
opt requested gear differs
  Step -> Driveline : shift(gear, clutch capacity == 0)
end
Step -> Chassis : axle_loads(state, drawbar)
Chassis --> Step : rear / front / wheelie bar load
Step -> Tire : traction(wheel speed, ground speed, load per tire, rear surface)
Tire --> Step : force, slope (linearized), slip
Step -> Tire : driven_rolling_resistance(rear load per tire, slip, rear surface)
Step -> Tire : thrown_soil_m3_s(rear load per tire, slip, wheel speed, rear surface)
Step -> Tire : towed_rolling_resistance(front load per tire, front surface)
Step -> Engine : predict(throttle)
Step -> Driveline : predict(rear rolling resistance torque)
Step -> Chassis : predict(drawbar pull + front tire and bar rolling drag)
Step -> Solve : engine line, driveline Response, TireLine, body line
Solve -> Solve : lock torque with the tire force eliminated\n(branch by the torque's sign: gearbox efficiency)
Solve -> Clutch : resolve(capacity, lock torque)
Clutch --> Solve : torque: locked, or kinetic capacity if slipping
Solve -> Solve : tire force for that clutch torque
Solve --> Step : clutch torque, tire force
Step -> Engine : advance(load = clutch torque)
Step -> Driveline : advance(clutch torque, axle torque = -r * tire force)
Step -> Chassis : advance(drive force = tire force)
Step -> Step : axle torque from the axle's balance
Step -> Chassis : advance_pitch(axle torque, drawbar pull and lift,\n  front rolling resistance)\n(see the pitch step)
Step --> Caller : Output
@enduml
