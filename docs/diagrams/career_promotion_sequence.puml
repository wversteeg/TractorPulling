@startuml career_promotion_sequence
title A season won, and the move up a class (the game)
skinparam sequenceMessageAlign center

actor Player
participant "pull.gd" as Game
participant "TractorPullEvent" as Event
participant "field::LiveSeason" as Season
participant "tp::career" as Career

Game -> Event : load_career(career_path) (at launch)
Event -> Event : data::load_career: the ladder,\neach class's season checked
Game -> Event : resume_career(save) or new_season(seed)
Event -> Event : start_season(the class's season)

== the season's last event ==
Game -> Event : score_event()
Event -> Season : score_event(prizes, career)
Season --> Event : scored, the season over
Event -> Career : finish_season(progress, ladder,\nstandings, kPlayer)
Career --> Event : the class above opened (a title)
Game -> Event : get_career()
Event --> Game : can_move_up, next_class
Game -> Player : the season's board: "Move up"\nor "Stay in <class>"

alt Move up
  Player -> Game : Move up
  Game -> Event : move_up(seed)
  Event -> Career : move_up(progress)
  Event -> Event : start_season(the class above's season):\nmoney and upgrades carried, by name
else Stay
  Player -> Game : Stay
  Game -> Event : new_season(seed)
  note right : the class above stays open; the start\nscreen offers "Move up" until the\nseason's first pull, and the board\nasks again after the season
end
Game -> Game : save (version 3: the class\nand the class opened, by name)
@enduml
