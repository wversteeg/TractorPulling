@startuml engine_step_sequence
title engine::step = predict + advance (one 1 kHz step)
autonumber
participant "Caller\n(dyno tool, or a coupling\nsuch as the clutch)" as Caller
participant "engine::predict" as Predict
participant "governor_fuel" as Gov
participant "exhaust_energy" as Exh
participant "Params::full_load_torque_nm\n(math::Curve)" as Curve
participant "engine::advance" as Advance

Caller -> Predict : predict(state, params, throttle, dt_s)
note right of Predict : pure: reads state, changes nothing
Predict -> Predict : throttle = clamp(throttle, 0, 1)
alt state.running
  Predict -> Gov : (params, throttle, omega)
  Gov --> Predict : fuel = clamp((target - omega) / droop, 0, 1)
else stalled
  Predict -> Predict : fuel = 0
end
Predict -> Exh : (params, omega)
Exh --> Predict : 0..1, rising from boost onset to full boost
Predict -> Predict : boost_next = boost + (fuel * exhaust - boost) * dt / (tau + dt)\n(implicit lag, no exp())
Predict -> Curve : evaluate(omega)
Curve --> Predict : full-load torque [N·m]
Predict -> Predict : combustion = fuel * full_load * (na + (1 - na) * boost_next)\ndrive = combustion - friction_constant
Predict --> Caller : Prediction

opt coupled to another shaft
  Caller -> Caller : shaft_prediction(prediction)\nomega_next = free + k * applied_torque\n(solve the coupling for the load torque)
end

Caller -> Advance : advance(state, params, prediction, load_torque_nm)
Advance -> Advance : boost = boost_next
Advance -> Advance : omega' = (omega + dt/I * (drive - load)) / (1 + dt/I * viscous)\n(semi-implicit Euler)
Advance -> Advance : omega = max(omega', 0)
opt running and omega < stall speed
  Advance -> Advance : running = false
end
@enduml
