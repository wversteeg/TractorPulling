@startuml event_classes
title Event (tp::event): one class at an event, pull by pull
hide empty members
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0

package "other components" {
  class "sled::Params\n+ adjusted(), heavier()" as Sled
  class "math::SplitMix64" as Random
}

package "tp::event" {
  class Rules <<struct>> {
    +full_pull_m : double, 100
    +extended_full_pull_m : double, 110
    +max_distance_m : double, 130
    +pull_off_places : int, 4
    +qualifying_distance_m : double, 90
    +decide_after_pulls : int, 2
    +repull_after_pulls : int, 5
    +sled_target_m : double, 90
    +step_m : double, 5
  }
  class Pull <<struct>> {
    +puller : int
    +kind : PullKind
    +pull_off_round : int
  }
  enum PullKind {
    kTest
    kCompetition
    kRepull
    kPullOff
  }
  enum SledChange {
    kNone
    kLineExtended
    kLighter
    kHeavier
  }
  class Outcome <<struct>> {
    +change : SledChange
    +steps : int
  }
  class Standing <<struct>> {
    +puller, place : int
    +distance_m : double
    +full_pull : bool
    +pull_off_rounds : int
    +pull_off_distance_m : double
  }
  class Event {
    -rules_ : Rules
    -sled_ : sled::Params
    -line_m_ : double
    -queue_ : array<Pull>
    -entries_ : array<Entry, 32>
    +{static} create(const Rules&, const sled::Params&, span<const int> order) : optional<Event>
    +next() : optional<Pull>
    +sled() : const sled::Params&
    +full_pull_m() : double
    +record(reached_m) : Outcome
    +decision_due() : optional<int>
    +suggested_keep() : bool
    +decide(keep : bool)
    +finished() : bool
    +standings() : span<const Standing>
  }
  class "event functions" as EventFns <<free functions>> {
    +validate(const Rules&) : optional<ParamError>
    +running_order(count, seed) : array<int, 32>
  }
  Event *-- Rules
  Event ..> Pull
  Event ..> Outcome
  Event ..> Standing
  Pull *-- PullKind
  Outcome *-- SledChange
}
Event *-- Sled
Event ..> Sled : operator changes,\npull-off steps
EventFns ..> Random
note bottom of Event
  test pull: first pull, and the first after every sled change;
  100 m <= test < 110 m: line to 110 m, sled stays;
  test past the line: heavier by ceil(over / step); the test puller re-pulls;
  test short of the target: lighter (knives out, then push-down later);
  test puller may keep an unchanged or lighter sled's pull: decides after pull +2,
  re-pulls after pull +5 (the 6th);
  pull-off: full pulls, filled to 4 from 90 m; sled heavier so the strongest stops
  at the line; again among those who full-pull again
end note
@enduml
