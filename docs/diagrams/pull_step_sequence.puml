@startuml pull_step_sequence
title pull::step: one 1 kHz step of tractor, chain and sled
autonumber
participant "Caller\n(run::step, test)" as Caller
participant "pull::step" as Step
participant "chassis::hitch" as Hitch
participant "chain_force" as Chain
participant "track::Model" as Track
participant "vehicle::step" as Vehicle
participant "sled" as Sled

Caller -> Step : step(state, model, {throttle, clutch_pedal, gear}, dt_s)
Step -> Hitch : hitch(tractor chassis state)
Hitch --> Step : hitch position and velocity (with pitch and heading)
Step -> Sled : hook(sled state)
Sled --> Step : hook position and velocity (with heading)
Step -> Chain : chain_force(chain, hitch, hook)
Chain --> Step : tension along the hook-to-hitch line\n(zero when slack, never pushing)
Step -> Step : equal and opposite:\nDrawbar{pull, lift, side} on the hitch (body frame),\nHookForce{forward, up, side} on the hook (sled frame)
Step -> Track : surface_at(rear axle), surface_at(front axle),\nsurface_at(sled pan), surface_at(sled wheels)
Track --> Step : the ground under each contact
Step -> Vehicle : step(tractor, input, Ground{rear, front}, drawbar)\n(see the vehicle step)
Vehicle --> Step : tractor output
Step -> Sled : loads(state, hook force, Ground{pan, wheels})
Sled --> Step : pan / wheel loads, box position,\npush-down, resistance
Step -> Sled : predict(resistance)
Step -> Sled : advance_lateral(loads, hook side pull, wheel ground)\n(sideways and yaw: wheels' side grip, pan friction implicit)
Step -> Sled : advance(forward pull): moves along its heading
Step -> Sled : collect(soil the tractor threw back)\n(the berm grows, and spills as the sled moves)
Step --> Caller : Output{tractor, sled loads, chain}
@enduml
