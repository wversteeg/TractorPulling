@startuml event_sequence
title An event: test pull, sled changes, decisions and pull-offs
autonumber
participant "Front end\n(or tp_pull event)" as Caller
participant "event::Event" as Event
participant "pull + run\n(one pull each)" as Run

Caller -> Caller : every driver guesses a gear for the track\n(field::best_gear, guess_gear)
Caller -> Event : create(rules, class sled, running_order(n, seed))
loop until finished()
  alt decision_due()
    Caller -> Event : decide(keep)\n(the player, or suggested_keep())
    Event -> Event : keep: the test pull counts;\nre-pull: queued after the 6th pull
  else next() is a pull
    Caller -> Event : next(), sled(), full_pull_m()
    Caller -> Run : run the puller (a little different each pull)\non sled() until the sled stops or reaches max_distance_m
    Run --> Caller : where it stopped, and how it ended
    alt a tractor tire touched a chalk line
      Caller -> Event : record_disqualified()
      Event -> Event : 0 m, behind every pull that counts;\na test pull: the sled stays, the next puller tests
    else
      Caller -> Event : record(reached_m)
      opt test pull
        Event -> Event : operator: line to 110 m, lighter or heavier;\nafter a change the next puller tests
      end
    end
    opt round over
      Event -> Event : qualifiers; pull-off sled heavier\nby the strongest full pull
    end
  end
end
Caller -> Event : standings()
@enduml
