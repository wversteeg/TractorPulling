@startuml data_io_classes
title Data loading (tp::data): may throw internally, allocates, never used in the step
hide empty members
top to bottom direction
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0

package "tp::data" {
  class LoadError <<struct>> {
    +message : string
  }
  class "Result<T>" as Result {
    -value_ : variant<T, LoadError>
    +ok() : bool
    +value() : const T&
    +error() : const LoadError&
  }
  class "component loaders" as Loaders <<free functions>> {
    +load_engine(path) / parse_engine(text, source) : Result<engine::Params>
    +load_clutch(path) / parse_clutch(text, source) : Result<clutch::Params>
    +load_easy_controls(path) / parse_easy_controls(text, source) : Result<controls::EasyParams>
    +load_driveline(path) / parse_driveline(text, source) : Result<driveline::Params>
    +load_tire(path) / parse_tire(text, source) : Result<tire::Params>
    +load_class_rules(path) / parse_class_rules(text, source) : Result<rules::ClassRules>
    +load_sled(path) / parse_sled(text, source) : Result<sled::Params>
    +load_track(path) / parse_track(text, source) : Result<Track>
    --
    each: read fields, convert to SI, build Params,
    <component>::validate(), name the field on error
  }
  class Track <<struct>> {
    +rules : run::Rules
    +ground : track::Params, soil and profile
    +sled : sled::Conditions, the day's push-down
  }
  class EventDefinition <<struct>> {
    +class_rules : rules::ClassRules
    +rules : event::Rules
    +reference : field::Puller
    +variation : field::Variation
    +pull_to_pull : field::PullToPull
    +pullers : int
    +seed : uint64
    +sled : sled::Params
    +track : Track
  }
  class "event_loader" as EventLoader <<free functions>> {
    +load_event(path) : Result<EventDefinition>
    +parse_event(text, source, base_directory) : Result<EventDefinition>
    --
    loads the class, tractor, sled and track it names
    relative to the event file, then validates the rules and field
  }
  class SeasonDefinition <<struct>> {
    +event : EventDefinition
    +points : season::Points
    +rounds : vector<SeasonRound{name, Track}>
    +seed : uint64
  }
  class "season_loader" as SeasonLoader <<free functions>> {
    +load_season(path) : Result<SeasonDefinition>
    +parse_season(text, source, base_directory) : Result<SeasonDefinition>
  }
  class "tractor_loader" as TractorLoader <<free functions>> {
    +load_tractor(path) : Result<vehicle::Params>
    +parse_tractor(text, source, base_directory) : Result<vehicle::Params>
    --
    reads the chassis, front tire size, PTO efficiency and the component paths,
    loads each component relative to the tractor file,
    then vehicle::validate()
  }
  Result o-- LoadError
  Loaders ..> Result : returns
  Loaders ..> Track
  EventLoader ..> EventDefinition
  EventLoader ..> Loaders : components
  EventLoader ..> TractorLoader
  EventDefinition *-- Track
  SeasonLoader ..> SeasonDefinition
  SeasonLoader ..> EventLoader
  SeasonDefinition *-- EventDefinition
  TractorLoader ..> Loaders : components
  TractorLoader ..> Result : returns
}

package "tp::data::detail (internal)" {
  class Reader {
    +number(dotted_path) : double
    +integer(dotted_path) : int64
    +text(dotted_path) : string
    +numbers(dotted_path) : vector<double>
    +curve(table, x_key, y_key, x_to_si) : optional<Curve>
    +error() : optional<LoadError>
  }
  class "toml_reader" as TomlFns <<free functions>> {
    +parse_with<T>(text, source, loader) : Result<T>
    +load_file_with<T>(path, loader) : Result<T>
    +make_error(source, field, reason) : LoadError
  }
}
Loaders ..> TomlFns
Loaders ..> Reader

package "tp::core (see the component class diagrams)" {
  class "<component>::Params\n+ <component>::validate()" as CoreParams <<struct>>
  class "math::Curve" as Curve
}

package "third party" {
  class "toml++" as Toml <<library>>
}

TomlFns ..> Toml : parse
Reader ..> Curve : create
Loaders ..> CoreParams : builds, validates
TractorLoader ..> Reader
TractorLoader ..> CoreParams : vehicle::Params
@enduml
