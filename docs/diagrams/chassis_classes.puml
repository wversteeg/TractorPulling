@startuml chassis_classes
title Chassis (tp::chassis): the body moving in the ground plane, turning and pitching
hide empty members
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0

package "tp::chassis" {
  class Params <<struct>> {
    +mass_kg : double
    +wheelbase_m : double
    +cg_ahead_of_rear_axle_m : double
    +cg_height_m : double
    +pitch_inertia_kg_m2 : double
    +yaw_inertia_kg_m2 : double
    +rear_axle_height_m : double
    +rear_track_m : double
    +front_track_m : double
    +hitch_height_m : double
    +hitch_behind_rear_axle_m : double
    +front_tires : Contact
    +wheelie_bar : WheelieBar
    +ballast : Ballast
  }
  class Ballast <<struct>> {
    +mass_kg : double
    +rear_ahead_of_rear_axle_m : double
    +front_ahead_of_rear_axle_m : double
    +position : double
    --
    weights moved before a pull,
    part of the mass; 0 rearmost, 1 foremost
  }
  class Contact <<struct>> {
    +stiffness_n_per_m : double
    +damping_n_s_per_m : double
  }
  class WheelieBar <<struct>> {
    +behind_rear_axle_m : double
    +tip_height_m : double
    +contact : Contact
    +rolling_resistance_coefficient : double
  }
  class State <<struct>> {
    +position_m : double
    +velocity_m_s : double
    +acceleration_m_s2 : double
    +pitch_rad : double
    +pitch_rate_rad_s : double
    +pitch_acceleration_rad_s2 : double
    +lateral_position_m : double
    +heading_rad : double
    +lateral_velocity_m_s : double
    +yaw_rate_rad_s : double
  }
  class AxleLoads <<struct>> {
    +rear_n : double
    +front_n : double
    +wheelie_bar_n : double
    +front_lifted : bool
  }
  class Drawbar <<struct>> {
    +pull_n : double
    +lift_n : double
    +side_n : double
  }
  class SideForces <<struct>> {
    +front_n : double
    +rear_n : double
    +hitch_n : double
    +yaw_moment_nm : double
  }
  class Hitch <<struct>> {
    +x_m, y_m, z_m : double
    +velocity_x_m_s, velocity_y_m_s, velocity_z_m_s : double
  }
  class Prediction <<struct>> {
    +free_velocity_m_s : double
    +velocity_per_n : double
  }
  enum ParamError
  class "chassis functions" as ChassisFns <<free functions>> {
    +{static} kMaxWheelieBarContactPitch_rad = 30°
    +validate(const Params&) : optional<ParamError>
    +with_ballast_at(const Params&, position) : Params
    +rear_axle_share(const Params&) : double
    +hitch(const Params&, const State&) : Hitch
    +axle_loads(const Params&, const State&, const Drawbar&) : AxleLoads
    +axle_loads_at_rest(const Params&) : AxleLoads
    +predict(const State&, const Params&, resisting_force_n, dt_s) : Prediction
    +end_velocity_m_s(const Prediction&, drive_force_n) : double
    +advance_lateral(State&, const Params&, const SideForces&, dt_s)
    +advance(State&, const Prediction&, drive_force_n, dt_s)
    +advance_pitch(State&, const Params&, axle_torque_nm, const Drawbar&,\n      front_rolling_resistance, dt_s)
    +hash_append(Fnv1a&, const State&)
  }
  Params *-- Contact : front_tires
  Params *-- WheelieBar
  Params *-- Ballast
  WheelieBar *-- Contact
  ChassisFns ..> Params
  ChassisFns ..> State
  ChassisFns ..> AxleLoads
  ChassisFns ..> Prediction
  ChassisFns ..> Drawbar
  ChassisFns ..> Hitch
  ChassisFns ..> SideForces
  ChassisFns ..> ParamError
}
note bottom of ChassisFns
  pitch θ about the rear axle, nose-up positive:
  I θ'' = τ_axle + F_pull z_hitch + F_lift x_hitch - m g x_cg + m a z_cg
          + front tires + wheelie bar - ground drag · r
  contacts: one-sided spring-dampers, implicit midpoint;
  geometry through math::sin_cos
  in the plane, at the centre of gravity (body frame):
  m (u' - v_cg r) = ΣF_x,  m (v_cg' + u r) = ΣF_y,  I_z r' = ΣM_z
  side forces at the front axle, rear axle and hitch;
  heading through math::sin_cos_any
end note
@enduml
