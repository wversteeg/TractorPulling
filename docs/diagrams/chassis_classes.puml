@startuml chassis_classes
title Chassis (tp::chassis): longitudinal body and weight transfer
hide empty members
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0

package "tp::chassis" {
  class Params <<struct>> {
    +mass_kg : double
    +wheelbase_m : double
    +cg_ahead_of_rear_axle_m : double
    +cg_height_m : double
    +hitch_height_m : double
    +front_rolling_resistance_coefficient : double
  }
  class State <<struct>> {
    +position_m : double
    +velocity_m_s : double
    +acceleration_m_s2 : double
  }
  class AxleLoads <<struct>> {
    +rear_n : double
    +front_n : double
    +front_lifted : bool
  }
  class Prediction <<struct>> {
    +free_velocity_m_s : double
    +velocity_per_n : double
  }
  enum ParamError
  class "chassis functions" as ChassisFns <<free functions>> {
    +validate(const Params&) : optional<ParamError>
    +axle_loads(const Params&, acceleration, drawbar_force_n) : AxleLoads
    +predict(const State&, const Params&, resisting_force_n, dt_s) : Prediction
    +advance(State&, const Prediction&, drive_force_n, dt_s)
    +hash_append(Fnv1a&, const State&)
  }
  ChassisFns ..> Params
  ChassisFns ..> State
  ChassisFns ..> AxleLoads
  ChassisFns ..> Prediction
  ChassisFns ..> ParamError
}
note bottom of AxleLoads
  quasi-static: rear = m g (L - b) / L + (m a h_cg + F_drawbar h_hitch) / L
  pitch dynamics replace this in Milestone 1, step 5
end note
@enduml
