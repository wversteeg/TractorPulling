@startuml track_classes
title Track (tp::track): the soil along the track, sampled at setup
hide empty members
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0

package "other components" {
  class "soil::Composition / Surface\n+ surface()" as Soil
  class "math::Curve" as Curve
}

package "tp::track" {
  class Params <<struct>> {
    +soil : soil::Composition
    +moisture_along_m : optional<Curve>
    +compaction_along_m : optional<Curve>
    +grip_scale : double, 0.5 to 1.5 (how it was prepared)
    +hard_spots : optional<HardSpots>
    +weak_spots : optional<WeakSpots>
    +spots_across_m : double, the lane's width
  }
  class HardSpots <<struct>> {
    +every_m, length_m, width_m : double
    +extra : double, 0 to 2
    +seed : uint32
  }
  class WeakSpots <<struct>> {
    +every_m, length_m, width_m : double
    +grip_loss : double, 0 to 0.5
    +seed : uint32
  }
  class Spot <<struct>> {
    +start_m, length_m : double
    +centre_y_m, width_m : double
    +peak : double
  }
  class SpotLayout {
    -spots_ : array<Spot, 160>, by start
    -count_ : size_t
    +lay(every_m, length_m, width_m, across_m, size, seed)
    +at(x_m, y_m) : double, 0 to the spot's peak
    +spots() : span<const Spot>
  }
  class Model {
    +{static} kMaxSamples = 512
    +{static} kSampleSpacing_m = 0.5
    -params_ : Params
    -first_x_m_, spacing_m_ : double
    -samples_ : array<soil::Surface, 512>
    +{static} kHardSpotsUntil_m = 200
    +{static} kMaxHardSpots = 160
    -hard_, weak_ : SpotLayout
    +{static} create(const Params&) : optional<Model>
    +params() : const Params&
    +surface_at(x_m, y_m = 0) : soil::Surface
    +surface_across(x_m, y_m, half_width_m) : soil::Surface
    +hard_spots(), weak_spots() : span<const Spot>
    -surface_without_spots(x_m) : soil::Surface
  }
  enum ParamError {
    kSoil
    kMoistureProfile
    kCompactionProfile
    kGripScale
    kHardSpots
    kWeakSpots
    kSpotsAcross
  }
  class "track functions" as TrackFns <<free functions>> {
    +validate(const Params&) : optional<ParamError>
    +composition_at(const Params&, x_m) : soil::Composition
    +strength_at(const Spot&, x_m, y_m) : double
  }
  Model *-- Params
  Params *-- HardSpots
  Params *-- WeakSpots
  Model *-- "2" SpotLayout : hard_, weak_
  SpotLayout *-- Spot
  TrackFns ..> Params
  TrackFns ..> ParamError
}
Params *-- Curve
Params *-- Soil
Model ..> Soil : samples surface()\nat setup
note bottom of Model
  x from the start line (the sled's rear wheels at the start);
  profiles hold their end values beyond their ends;
  in the step: a lookup and a blend of two samples, no soil model;
  hard and weak spots laid from their seeds at setup (xorshift), the
  same on every platform, over the first 200 m, each somewhere across
  the lane (any line as likely to cross one): surface_at() evaluates
  the spot under (x, y) exactly (a binary search along x): a hard spot
  raises the drag_scale, a weak spot lowers the grip_factor;
  surface_across() takes their mean over a width (the sled's pan)
end note
@enduml
