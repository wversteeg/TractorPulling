; The C++ extension (extension/): tp::session for GDScript. Build it with the
; godot presets (see the README); the libraries land in bin/.
;
; Only debug libraries for now: godot-cpp's template_debug target, which the
; editor and debug exports load (the presets' Release is the C++
; optimisation, not Godot's build target). The game is exported as a debug
; build (export_presets.cfg); release libraries and a signed release export
; come when the game is published.

[configuration]

entry_symbol = "tractor_pulling_init"
compatibility_minimum = "4.7"

[libraries]

linux.debug.x86_64 = "res://bin/libtp_godot.linux.template_debug.x86_64.so"
android.debug.arm64 = "res://bin/libtp_godot.android.template_debug.arm64.so"
android.debug.x86_64 = "res://bin/libtp_godot.android.template_debug.x86_64.so"
windows.debug.x86_64 = "res://bin/libtp_godot.windows.template_debug.x86_64.dll"
